{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sisal:web-scout:response:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagnostic_only",
    "ready_for_analysis",
    "ready_for_quant",
    "statistics_usable_in_production",
    "execution_mode",
    "status",
    "requested_event",
    "verified_at",
    "identity",
    "teams",
    "blockers",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "football-web-research-v1.1"
    },
    "diagnostic_only": {
      "const": true
    },
    "ready_for_analysis": {
      "const": false
    },
    "ready_for_quant": {
      "const": false
    },
    "statistics_usable_in_production": {
      "const": false
    },
    "execution_mode": {
      "enum": [
        "synthetic_offline_fixture",
        "real_only_cache"
      ]
    },
    "status": {
      "enum": [
        "diagnostic_available",
        "verified",
        "reported_unconfirmed",
        "conflicting",
        "not_found",
        "source_stale",
        "source_blocked",
        "identity_unverified",
        "temporal_unverified",
        "data_unverified"
      ]
    },
    "requested_event": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "canonical_mapping_reference_verified": {
              "const": true
            },
            "current_event_verified": {
              "const": false
            },
            "basis": {
              "const": "prior_saved_identity_review_not_new_live_validation"
            },
            "reference": {
              "type": "string",
              "pattern": "^history-v2:[a-z0-9-]+$"
            },
            "reference_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "competition": {
              "enum": [
                "SA",
                "SB",
                "PL",
                "PD",
                "BL1",
                "FL1",
                "DED",
                "PPL",
                "ELC",
                "BPL",
                "CL",
                "EL",
                "ECL"
              ]
            },
            "kickoff_utc": {
              "type": "string",
              "format": "date-time"
            },
            "teams": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "home": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "canonical_id": {
                      "type": "string",
                      "pattern": "^local:team:[a-z0-9-]+$"
                    },
                    "provider_ids": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "api_football": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "football_data": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "api_football",
                        "football_data"
                      ]
                    },
                    "display_name": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "canonical_id",
                    "provider_ids",
                    "display_name"
                  ]
                },
                "away": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "canonical_id": {
                      "type": "string",
                      "pattern": "^local:team:[a-z0-9-]+$"
                    },
                    "provider_ids": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "api_football": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "football_data": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "api_football",
                        "football_data"
                      ]
                    },
                    "display_name": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "canonical_id",
                    "provider_ids",
                    "display_name"
                  ]
                }
              },
              "required": [
                "home",
                "away"
              ]
            },
            "api_football_fixture_id": {
              "type": "integer",
              "minimum": 1
            },
            "football_data_match_id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "canonical_mapping_reference_verified",
            "current_event_verified",
            "basis",
            "reference",
            "reference_commit",
            "competition",
            "kickoff_utc",
            "teams",
            "api_football_fixture_id",
            "football_data_match_id"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "$ref": "#/$defs/team"
        },
        "away": {
          "$ref": "#/$defs/team"
        }
      },
      "required": []
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_web_requests",
        "cache_revision",
        "real_web_claims_verified",
        "untrusted_content_is_data",
        "current_event_revalidated",
        "upstream_statistics_imported"
      ],
      "properties": {
        "new_web_requests": {
          "const": 0
        },
        "cache_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "real_web_claims_verified": {
          "type": "integer",
          "minimum": 0
        },
        "untrusted_content_is_data": {
          "const": true
        },
        "current_event_revalidated": {
          "const": false
        },
        "upstream_statistics_imported": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,80}$"
        },
        "team_id": {
          "type": "string",
          "pattern": "^local:team:[a-z0-9-]+$"
        },
        "event_key": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "category": {
          "enum": [
            "recent_results",
            "standings",
            "injury",
            "suspension",
            "availability",
            "probable_lineup",
            "official_lineup",
            "schedule",
            "news"
          ]
        },
        "claim_key": {
          "type": "string",
          "pattern": "^[a-z0-9:-]{1,100}$"
        },
        "effective_at": {
          "type": "string",
          "format": "date"
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "array",
              "maxItems": 22,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "player_id": {
                  "type": "string",
                  "maxLength": 80
                },
                "statement": {
                  "type": "string",
                  "maxLength": 200
                },
                "availability": {
                  "enum": [
                    "available",
                    "unavailable",
                    "uncertain"
                  ]
                },
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "match_ids": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "lineup": {
                  "type": "array",
                  "maxItems": 11,
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,50}$"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "fresh_until": {
          "type": "string",
          "format": "date-time"
        },
        "origin": {
          "enum": [
            "real_saved",
            "synthetic"
          ]
        },
        "assertion": {
          "enum": [
            "confirmed",
            "reported",
            "probable"
          ]
        },
        "evidence_file": {
          "type": "string",
          "pattern": "^evidence/[a-z0-9-]+\\.json$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_type": {
          "enum": [
            "official_club",
            "official_competition",
            "official_federation",
            "public_press",
            "documented_statistics",
            null
          ]
        },
        "status": {
          "enum": [
            "verified",
            "reported_unconfirmed",
            "conflicting",
            "not_found",
            "source_stale",
            "source_blocked",
            "identity_unverified",
            "data_unverified"
          ]
        },
        "eligible_pre_match": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "untrusted_source_content": {
          "const": true
        }
      },
      "required": [
        "id",
        "team_id",
        "event_key",
        "category",
        "claim_key",
        "effective_at",
        "value",
        "description",
        "source_id",
        "url",
        "published_at",
        "publication_date",
        "collected_at",
        "fresh_until",
        "origin",
        "assertion",
        "evidence_file",
        "evidence_sha256",
        "source_type",
        "status",
        "eligible_pre_match",
        "reasons",
        "untrusted_source_content"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "origin": {
          "enum": [
            "real_access_attempt",
            "real_saved",
            "unverified"
          ]
        },
        "status": {
          "enum": [
            "source_blocked",
            "reported_unconfirmed"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "proxy_tunnel_status": {
          "enum": [
            403,
            null
          ]
        },
        "content_retrieved": {
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "collected_at",
        "origin",
        "status",
        "reason",
        "http_status",
        "proxy_tunnel_status",
        "content_retrieved"
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "verified",
            "reported_unconfirmed",
            "conflicting",
            "not_found",
            "source_stale",
            "source_blocked",
            "identity_unverified",
            "data_unverified"
          ]
        },
        "claims": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "search_scope": {
          "const": "saved_cache_only"
        },
        "absence_is_not_proof_of_no_injury_or_suspension": {
          "const": true
        }
      },
      "required": [
        "status",
        "claims",
        "search_scope",
        "absence_is_not_proof_of_no_injury_or_suspension"
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "type": "string",
          "pattern": "^local:team:[a-z0-9-]+$"
        },
        "provider_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api_football": {
              "type": "integer",
              "minimum": 1
            },
            "football_data": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "api_football",
            "football_data"
          ]
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recent_results": {
              "$ref": "#/$defs/category"
            },
            "standings": {
              "$ref": "#/$defs/category"
            },
            "injury": {
              "$ref": "#/$defs/category"
            },
            "suspension": {
              "$ref": "#/$defs/category"
            },
            "availability": {
              "$ref": "#/$defs/category"
            },
            "probable_lineup": {
              "$ref": "#/$defs/category"
            },
            "official_lineup": {
              "$ref": "#/$defs/category"
            },
            "schedule": {
              "$ref": "#/$defs/category"
            },
            "news": {
              "$ref": "#/$defs/category"
            }
          },
          "required": [
            "recent_results",
            "standings",
            "injury",
            "suspension",
            "availability",
            "probable_lineup",
            "official_lineup",
            "schedule",
            "news"
          ]
        },
        "source_access_observations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "required": [
        "canonical_id",
        "provider_ids",
        "categories",
        "source_access_observations"
      ]
    }
  }
}
