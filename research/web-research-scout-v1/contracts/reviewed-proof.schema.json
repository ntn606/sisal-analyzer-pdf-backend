{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "url",
    "team_id",
    "event_key",
    "origin",
    "claim_projection_sha256",
    "reviewer_ref",
    "reviewed_at",
    "official_lineup_explicit"
  ],
  "properties": {
    "schema_version": {
      "const": "web-scout-reviewed-claim.1"
    },
    "source_id": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "team_id": {
      "type": "string",
      "pattern": "^local:team:[a-z0-9-]+$"
    },
    "event_key": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "origin": {
      "enum": [
        "real_saved",
        "synthetic"
      ]
    },
    "claim_projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer_ref": {
      "type": "string",
      "maxLength": 80
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "official_lineup_explicit": {
      "type": "boolean"
    }
  }
}
