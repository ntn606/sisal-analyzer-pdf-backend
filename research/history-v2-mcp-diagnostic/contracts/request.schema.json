{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sisal:football-history-v2-probe:request:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "palinsesto",
    "avvenimento",
    "match_date"
  ],
  "properties": {
    "palinsesto": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "avvenimento": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "match_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
